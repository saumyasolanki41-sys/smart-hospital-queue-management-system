    },
    {
      "name": "Staff queue",
      "description": "New revision must be deployed first. Set staffAccessToken from admin/receptionist/doctor login. Keep the patient accessToken separate. Doctors require an admin-linked profile. See STAFF-QUEUE-API.md.",
      "item": [
        {
          "name": "Link verified doctor account (admin only)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{doctorUserId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "View doctor waiting queue",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/staff/queues/doctors/{{doctorId}}/tokens",
            "header": [],
