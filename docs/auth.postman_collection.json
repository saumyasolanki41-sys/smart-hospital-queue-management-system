    {
      "name": "Ambulance records",
      "description": "Backend vehicle inventory only. All calls need admin/receptionist staffAccessToken; create is admin only. No external integrations. New revision must be deployed first. See AMBULANCE-API.md.",
      "item": [
        {
          "name": "Create ambulance (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/ambulances",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"UP14AB1234\",\n  \"driverName\": \"Test Driver\",\n  \"driverPhone\": \"+919876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set(\"ambulanceId\", response.data.ambulance._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List available ambulances",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ambulances?status=available&page=1&limit=20",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Ambulance detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ambulances/{{ambulanceId}}",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update status and location",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/ambulances/{{ambulanceId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"busy\",\n  \"location\": {\n    \"latitude\": 28.6692,\n    \"longitude\": 77.4538\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ambulance transport requests",
      "description": "Backend-only workflow. Set baseUrl to http://localhost:8080 for local changes, accessToken to a patient token and staffAccessToken to admin/receptionist. First make ambulanceId available in inventory. Create captures ambulanceRequestId. Choose complete OR cancel; do not run this folder unattended. See AMBULANCE-REQUEST-API.md.",
      "item": [
        {
          "name": "Create transport request (patient)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ambulance-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": \"Gate 2, Test Road, Ghaziabad\",\n  \"latitude\": 28.6692,\n  \"longitude\": 77.4538,\n  \"contactPhone\": \"+919876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"ambulanceRequestId\", pm.response.json().data.request._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My transport requests (patient)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/ambulance-requests"
          },
          "response": []
        },
        {
          "name": "Pending transport requests (staff)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/ambulance-requests?status=pending&page=1&limit=20"
          },
          "response": []
        },
        {
          "name": "Transport request detail (patient)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/ambulance-requests/{{ambulanceRequestId}}"
          },
          "response": []
        },
        {
          "name": "Assign ambulance (staff)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ambulance-requests/{{ambulanceRequestId}}/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ambulanceId\": \"{{ambulanceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Complete transport (staff)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ambulance-requests/{{ambulanceRequestId}}/complete",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Cancel pending request (patient)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ambulance-requests/{{ambulanceRequestId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Cancel transport (staff)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ambulance-requests/{{ambulanceRequestId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Assigned ambulance arrival ETA",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/ambulance-requests/{{ambulanceRequestId}}/eta",
            "description": "Owner patient token or staff token. Needs assigned request, fresh vehicle location, routing key and ML config. Inspect source/reason; null is unavailable. See ML-INTEGRATION.md."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Doctor dashboard",
      "description": "Set doctorAccessToken from a doctor-role login linked by an admin to a doctor profile. Local baseUrl: http://localhost:8080. Hosted use requires deployment. See DOCTOR-DASHBOARD-API.md.",
      "item": [
        {
          "name": "My doctor dashboard",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctorAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/doctor/dashboard"
          },
          "response": []
        }
      ]
    }
  ]
}
