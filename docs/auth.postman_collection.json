              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Call next patient",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/staff/queues/doctors/{{doctorId}}/call-next",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set(\"calledTokenId\", response.data.token._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete called consultation",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/staff/queues/doctors/{{doctorId}}/tokens/{{calledTokenId}}/complete",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Set average consultation time (admin only)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"averageConsultationMinutes\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Admin token required. Set whole minutes from 1 to 120. Patient token status returns the estimated wait; this is not a guaranteed appointment time."
          },
          "response": []
        },
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/staff/dashboard",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Admin or receptionist token required. Returns current directory counts and token status counts for today in India. Optional ?date=YYYY-MM-DD filters token counts only. No body. See DASHBOARD-API.md. This revision must be deployed first."
          },
          "response": []
        },
        {
          "name": "Skip called patient",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/staff/queues/doctors/{{doctorId}}/tokens/{{calledTokenId}}/skip",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Use a staff token and the currently called token ID. No body. Sets skipped status and frees the queue. A repeated/invalid state returns 409. New revision must be deployed."
          },
          "response": []
        },
        {
          "name": "List skipped patients",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/staff/queues/doctors/{{doctorId}}/tokens?status=skipped",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Staff only. Returns skipped tokens for today; doctor role is limited to its linked profile."
          },
          "response": []
        }
      ]
