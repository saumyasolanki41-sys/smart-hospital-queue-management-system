{
  "info": {
    "name": "Hospital Queue API",
    "description": "Frontend and mobile authentication handoff. See AUTH-INTEGRATION.md. Set collection variables before use. Enter the latest email OTP manually for each flow. Do not run the whole collection unattended. Clear credentials and tokens before sharing a used export.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://smart-hospital-queue-management-system-production.up.railway.app",
      "type": "string"
    },
    {
      "key": "name",
      "value": "Test Patient",
      "type": "string"
    },
    {
      "key": "email",
      "value": "patient@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "TestPassword123!",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "NewPassword123!",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "challengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "googleIdToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "departmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "queueTokenId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Backend and database availability."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Request registration OTP. Wait 60 seconds before resend.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 202\", function () {",
              "  pm.response.to.have.status(202);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Verify registration",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register/verify",
        "description": "Set otp to the registration email code. Success creates an account without logging in.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Saves the actual challengeId from the response. Wait 60 seconds before resend.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 202\", function () {",
              "  pm.response.to.have.status(202);",
              "});",
              "if (pm.response.code === 202) {",
              "  const response = pm.response.json();",
              "  pm.collectionVariables.set(\"challengeId\", response.data.challengeId);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Verify login",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login/verify",
        "description": "Set otp to the login email code. Saves the application's accessToken.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const response = pm.response.json();",
              "  pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Google login",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/google",
        "description": "Set googleIdToken to a fresh Google ID token whose audience matches the configured backend web client ID.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const response = pm.response.json();",
              "  pm.collectionVariables.set(\"accessToken\", response.data.accessToken);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "description": "Uses accessToken in the Authorization Bearer header; no request body."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Forgot password",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/forgot-password",
        "description": "Request a password reset OTP. Generic response; no challengeId returned. Wait 60 seconds before resend.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 202\", function () {",
              "  pm.response.to.have.status(202);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/reset-password",
        "description": "Set otp to the reset email code. Clears saved accessToken on success. Update password to newPassword before the next login.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set(\"accessToken\", \"\");",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Departments and doctors",
      "description": "These endpoints require deploying the new revision. Use localhost:8080 for local testing. Writes require a token for a trusted admin account. See HOSPITAL-API.md.",
      "item": [
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments?page=1&limit=20",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Create department (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/departments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cardiology\",\n  \"description\": \"Heart care\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('departmentId', response.data.department._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors?page=1&limit=20",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Filter available doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors?departmentId={{departmentId}}&isAvailable=true",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Create doctor (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/doctors",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr Test Patient\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"specialization\": \"Cardiologist\",\n  \"experienceYears\": 5,\n  \"consultationFee\": 500,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('doctorId', response.data.doctor._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Doctor detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Update doctor (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Patient queue",
      "description": "New revision must be deployed first. Log in as a patient, not admin. Set doctorId from an available doctor profile. See QUEUE-API.md.",
      "item": [
        {
          "name": "Join queue (patient)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/queue/tokens",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set(\"queueTokenId\", response.data.token._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My tokens today",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/queue/tokens/mine",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "My token status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/queue/tokens/{{queueTokenId}}",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel my waiting token",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/queue/tokens/{{queueTokenId}}/cancel",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
