            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr Test Patient\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"specialization\": \"Cardiologist\",\n  \"experienceYears\": 5,\n  \"consultationFee\": 500,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
