          "name": "Filter available doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors?departmentId={{departmentId}}&isAvailable=true",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Create doctor (admin)",
