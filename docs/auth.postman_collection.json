                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('doctorId', response.data.doctor._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Doctor detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
