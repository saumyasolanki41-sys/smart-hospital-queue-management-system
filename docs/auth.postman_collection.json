    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/reset-password",
        "description": "Set otp to the reset email code. Clears saved accessToken on success. Update password to newPassword before the next login.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set(\"accessToken\", \"\");",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Departments and doctors",
      "description": "These endpoints require deploying the new revision. Use localhost:8080 for local testing. Writes require a token for a trusted admin account. See HOSPITAL-API.md.",
      "item": [
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments?page=1&limit=20",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Create department (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/departments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cardiology\",\n  \"description\": \"Heart care\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('departmentId', response.data.department._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors?page=1&limit=20",
